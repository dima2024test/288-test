<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <assignments>
        <name>Assign_Accounts</name>
        <label>Assign Accounts</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>AR3</assignToReference>
            <operator>Assign</operator>
            <value>
                <numberValue>10.0</numberValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Update_Accounts</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_Contact_Tally</name>
        <label>Assign Contact Tally</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>ContactTally</assignToReference>
            <operator>Add</operator>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Related_Contacts</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Log_Update_Fault</name>
        <label>Log Update Fault</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>UpdateErrorLog</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Account update failed during conditional revenue check</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Has_Many_Contacts</name>
        <label>Has Many Contacts?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Few Contacts</defaultConnectorLabel>
        <rules>
            <name>More_Than_Five_Contacts</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>ContactTally</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>5.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Followup_Task</targetReference>
            </connector>
            <label>More Than Five Contacts</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_Annual_Revenue_equals_10</name>
        <label>Is Annual Revenue equals 10?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Assign_Accounts</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes1</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Account.AnnualRevenue</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>10.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Was_the_AR_specified</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>Was_the_AR_specified</name>
        <label>Was the AR specified?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes</name>
            <conditionLogic>1</conditionLogic>
            <conditions>
                <leftValueReference>Update_Accounts</leftValueReference>
                <operator>WasVisited</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Opp</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>Auto-launched Flow that retrieves an Account, checks if its Annual Revenue equals 10, updates it if not, and then creates an Opportunity. Used for testing conditional logic and record updates in subflows.</description>
    <formulas>
        <name>fmlTaskSubject</name>
        <dataType>String</dataType>
        <expression>&quot;Follow up with &quot; &amp; TEXT({!ContactTally}) &amp; &quot; contacts&quot;</expression>
    </formulas>
    <interviewLabel>Pharos - Account Update Conditional {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Pharos - Account Update Conditional</label>
    <loops>
        <name>Loop_Related_Contacts</name>
        <label>Loop Related Contacts</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_Related_Contacts</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Assign_Contact_Tally</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Has_Many_Contacts</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
