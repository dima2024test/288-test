    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_Followup_Task</name>
        <label>Create Followup Task</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Subject</field>
