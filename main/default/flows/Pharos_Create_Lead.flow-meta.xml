<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <assignments>
        <name>Assign_Lead_Description</name>
        <label>Assign Lead Description</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>Get_Existing_Lead.Description</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Re-processed by Pharos Create Lead flow</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Update_Lead</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Log_Result</name>
        <label>Log Result</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>Pharos_Full_Stacktrace</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Lead processed successfully</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Check_Email_Provided</name>
        <label>Check Email Provided?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Create_Lead</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Email</defaultConnectorLabel>
        <rules>
            <name>Email_Provided</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>contactEmail</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Existing_Lead</targetReference>
            </connector>
            <label>Email Provided</label>
        </rules>
    </decisions>
    <decisions>
        <name>Has_Existing_Lead</name>
        <label>Has Existing Lead?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Create_Lead</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Existing Lead</defaultConnectorLabel>
        <rules>
            <name>Existing_Lead_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Existing_Lead</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Lead_Description</targetReference>
            </connector>
            <label>Existing Lead Found</label>
        </rules>
    </decisions>
    <description>Auto-launched Flow that creates a Lead record. Used for testing simple record creation in auto-launched flow context.</description>
    <formulas>
        <name>fmlCompanyName</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!contactEmail}), &quot;Unknown Company&quot;, {!contactEmail})</expression>
    </formulas>
    <formulas>
        <name>fmlLastName</name>
        <dataType>String</dataType>
        <expression>IF(OR(ISBLANK({!contactEmail}), NOT(CONTAINS({!contactEmail}, &quot;@&quot;))), &quot;Test&quot;, LEFT({!contactEmail}, FIND(&quot;@&quot;, {!contactEmail}) - 1))</expression>
    </formulas>
    <interviewLabel>Pharos - Create Lead {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Pharos - Create Lead</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_Lead</name>
        <label>Create Lead</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Log_Result</targetReference>
        </connector>
        <inputAssignments>
            <field>Company</field>
            <value>
                <elementReference>fmlCompanyName</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Email</field>
            <value>
                <elementReference>contactEmail</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>LastName</field>
            <value>
                <elementReference>fmlLastName</elementReference>
            </value>
        </inputAssignments>
        <object>Lead</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordLookups>
        <name>Get_Existing_Lead</name>
        <label>Get Existing Lead</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Has_Existing_Lead</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Email</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>contactEmail</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Lead</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Lead</name>
        <label>Update Lead</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Log_Result</targetReference>
        </connector>
        <inputReference>Get_Existing_Lead</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Check_Email_Provided</targetReference>
        </connector>
    </start>
    <status>Draft</status>
