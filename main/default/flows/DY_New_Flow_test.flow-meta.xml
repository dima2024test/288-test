    <formulas>
        <name>CleanedPhone</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!$Record.Phone}), {!$Record.Phone}, SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE({!$Record.Phone}, &quot;-&quot;, &quot;&quot;), &quot; &quot;, &quot;&quot;), &quot;(&quot;, &quot;&quot;), &quot;)&quot;, &quot;&quot;))</expression>
    </formulas>
    <formulas>
        <name>FlagNote</name>
        <dataType>String</dataType>
        <expression>IF(AND({!PhoneFlag}, {!EmailFlag}), &quot;Flagged: invalid phone and disposable email detected.&quot;, IF({!PhoneFlag}, &quot;Flagged: invalid/test phone number detected.&quot;, &quot;Flagged: disposable email domain detected.&quot;))</expression>
    </formulas>
    <formulas>
        <name>LowercaseEmail</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!$Record.Email}), {!$Record.Email}, LOWER({!$Record.Email}))</expression>
    </formulas>
