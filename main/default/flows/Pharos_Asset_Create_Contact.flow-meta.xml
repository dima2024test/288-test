<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <assignments>
        <name>Assign_Contact_Description</name>
        <label>Assign Contact Description</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>Get_Existing_Contacts.Description</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Linked to a new Asset record</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Update_Existing_Contact</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Log_Creation</name>
        <label>Log Creation</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>CreationLog</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>fmlAssetContactName</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Has_Existing_Contact</name>
        <label>Has Existing Contact?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Create_Contact</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Existing Contact</defaultConnectorLabel>
        <rules>
            <name>Existing_Contact_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Existing_Contacts</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Existing_Contact</targetReference>
            </connector>
            <label>Existing Contact Found</label>
        </rules>
    </decisions>
    <decisions>
        <name>Has_Serial_Number</name>
        <label>Has Serial Number?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Create_Contact</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Serial Number</defaultConnectorLabel>
        <rules>
            <name>Serial_Number_Present</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.SerialNumber</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Existing_Contacts</targetReference>
            </connector>
            <label>Serial Number Present</label>
        </rules>
    </decisions>
    <description>Record-triggered Flow on Asset (Create) that creates a Contact record. Used for testing simple record creation in trigger context.</description>
    <formulas>
        <name>fmlAssetContactName</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!$Record.Name}), &quot;Unknown Asset Contact&quot;, {!$Record.Name})</expression>
    </formulas>
    <interviewLabel>Pharos - Asset Create Contact {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Pharos - Asset Create Contact</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_Contact</name>
        <label>Create Contact</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Log_Creation</targetReference>
        </connector>
        <inputAssignments>
            <field>LastName</field>
            <value>
                <elementReference>fmlAssetContactName</elementReference>
            </value>
        </inputAssignments>
        <object>Contact</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordLookups>
        <name>Get_Existing_Contacts</name>
        <label>Get Existing Contacts</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Has_Existing_Contact</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>LastName</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>fmlAssetContactName</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Contact</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Existing_Contact</name>
        <label>Update Existing Contact</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Log_Creation</targetReference>
        </connector>
        <inputReference>Get_Existing_Contacts</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Has_Serial_Number</targetReference>
        </connector>
        <object>Asset</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Draft</status>
    <variables>
        <name>CreationLog</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
